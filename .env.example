# Copy this file to .env and fill in the values you want to override.
# Variables set in the shell always take precedence over this file.
# The .env file is gitignored — never commit it.

# Tracing filter (see https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html)
# Examples: "info", "debug", "engine=debug,tensor=warn"
RUST_LOG=info

# Milliseconds to sleep after each optimizer step during training.
# Useful for throttling GPU heat or slowing down log output for debugging.
# Defaults to 0 (no sleep) when unset.
# TRAIN_STEP_SLEEP_MS=0
